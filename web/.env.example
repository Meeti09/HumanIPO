# Copy to web/.env.local for local development, and set the same variables in Vercel.
# Every variable here is public — it ships to the browser. No secrets belong in this file.

# --- Network ---------------------------------------------------------------
# Monad Testnet JSON-RPC endpoint.
NEXT_PUBLIC_MONAD_RPC_URL=https://testnet-rpc.monad.xyz
# Monad Testnet chain id.
NEXT_PUBLIC_CHAIN_ID=10143
# Block explorer used for every transaction and address link in the UI.
NEXT_PUBLIC_EXPLORER_URL=https://testnet.monadexplorer.com

# --- Deployed contracts ----------------------------------------------------
# Printed by `forge script script/Deploy.s.sol:Deploy` and written to
# contracts/deployments/monad-testnet.json. See the README for the live addresses.
NEXT_PUBLIC_FACTORY_ADDRESS=
NEXT_PUBLIC_TEST_USD_ADDRESS=
NEXT_PUBLIC_VERIFIER_ADDRESS=

# --- Demo identities (optional) --------------------------------------------
# Public addresses the read-only demo identities map to. These hold no keys; they only
# decide whose on-chain positions the demo personas display. Defaults to the seed address.
NEXT_PUBLIC_DEMO_SEED_ADDRESS=
NEXT_PUBLIC_DEMO_INVESTOR_ADDRESS=
NEXT_PUBLIC_DEMO_RECIPIENT_ADDRESS=

# --- Links (optional) ------------------------------------------------------
# Shown in the footer and on the transparency page.
NEXT_PUBLIC_REPO_URL=
