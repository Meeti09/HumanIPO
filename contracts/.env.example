# Deployment-only secrets. Never commit the real .env file.
#
# Create contracts/.env from this template. The PRIVATE_KEY is used exclusively by
# `forge script` to sign deployment and seeding transactions. Use a throwaway key
# funded with a few testnet MON — never a key that holds anything of value.

MONAD_TESTNET_RPC_URL=https://testnet-rpc.monad.xyz

# 0x-prefixed private key of the deployer account.
PRIVATE_KEY=0x...

# Filled in by scripts/Deploy.s.sol output; required by script/Seed.s.sol.
FACTORY_ADDRESS=0x...
